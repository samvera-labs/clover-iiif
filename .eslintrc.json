{
  "plugins": ["@typescript-eslint"],
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "rules": {
    "@typescript-eslint/ban-ts-comment": "off",
    "@typescript-eslint/no-unused-vars": "error",
    "@typescript-eslint/no-explicit-any": "off"
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nulib/clover", "@nulib/clover/*", "**/packages/**"],
                "message": "3.x (@samvera/clover-iiif) must not import the 4.x package."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/clover/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "src/*",
                  "docs/*",
                  "@samvera/clover-iiif",
                  "@samvera/clover-iiif/*"
                ],
                "message": "@nulib/clover uses relative imports only and never reaches into 3.x."
              }
            ]
          }
        ]
      }
    }
  ]
}
