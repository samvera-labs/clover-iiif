{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": "./",
    "declaration": true,
    "declarationDir": "dist",
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "noEmitHelpers": true,
    "outDir": "dist",
    "paths": {
      "@nulib/clover": ["packages/clover/src/index.ts"],
      "@nulib/clover/styles.css": ["packages/clover/src/styles/clover.css"],
      "@nulib/clover/templates": ["packages/clover/src/templates/index.ts"],
      "@nulib/clover/map": ["packages/clover/src/map/index.ts"],
      "@nulib/clover/templates.css": [
        "packages/clover/src/templates/templates.css"
      ],
      "docs/*": ["docs/*"],
      "src/*": ["src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "esnext",
    "types": ["vitest/globals"]
  },
  // "paths": {
  //   "docs/*": ["docs/*"],
  //   "src/*": ["src/*"]
  // },
  "exclude": [
    "dist",
    "node_modules",
    "packages",
    "theme.config.tsx",
    "vite.*",
    "playwright",
    "playwright/**"
  ],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../index.ts",
    ".next/types/**/*.ts",
    "src/test.ts"
  ]
}
